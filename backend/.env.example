PORT=8080
# Ex. LISTEN_HOST=127.0.0.1 si tu passes le binaire en network_mode host derrière nginx.
# LISTEN_HOST=
# Comme sur un autre projet Atlas : URI seule + MONGODB_DB. Tu peux ajouter ?appName=neurorun
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.net/runapp?retryWrites=true&w=majority
MONGODB_DB=runapp
# Secours uniquement si problème TLS / IPv6 : MONGODB_FORCE_IPV4=1 et/ou MONGODB_TLS12_ONLY=1

JWT_SECRET=change-me-min-16-chars-secret

# Email (minuscules) qui reçoit automatiquement le rôle admin à l’inscription.
# ADMIN_EMAIL=toi@example.com

# Optionnel au démarrage : l’API tourne sans, mais la liaison Strava / le chat activités nécessitent les 3 lignes.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/api/strava/callback

# Une seule URL conseillée (ex. prod). Si tu mets plusieurs URLs séparées par des virgules, le backend
# garde pour Strava la première origine https hors localhost (évite redirects OAuth invalides).
FRONTEND_URL=http://localhost:3000
# Plusieurs origines : plutôt CORS_ALLOWED_ORIGINS. FRONTEND_URL est aussi fusionné dans CORS ; le backend ajoute
# CORS_ALLOWED_ORIGINS=https://ton-user.github.io

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Stripe — paiement des offres. Sans ces deux clés, le paiement carte est désactivé (503) et seules
# les souscriptions à 0 € (promo 100 %) passent. La clé publique est servie au front par
# GET /api/public/payment-config (le front est un build statique, pas d’env au runtime).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook (renouvellements, échecs de paiement, résiliations) :
#   local : stripe listen --forward-to localhost:8080/api/stripe/webhook
#   prod  : dashboard Stripe → https://neurorun.fr/api/stripe/webhook
# Événements : invoice.paid, invoice.payment_failed, customer.subscription.updated/deleted,
# et pour la boutique : checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# Boutique — dossier des images et vidéos envoyées depuis l'admin. En production :
# ~/projects/files/neurorun/boutique sur le VPS, monté par deploy/docker-compose.yml.
# SHOP_MEDIA_DIR=data/shop-media

# Apple In-App Purchase — paiement des offres depuis l'app iOS. La règle App Store 3.1.1 interdit
# Stripe pour du contenu numérique consommé dans l'app : l'app encaisse par StoreKit, le web par
# Stripe, et les deux activent le même champ `plan`. Sans ces clés, /api/checkout/apple/* répond 503.
#
# Clé « In-App Purchase » : App Store Connect → Users and Access → Integrations → In-App Purchase.
# Elle ne se télécharge qu'une fois (.p8).
APPLE_BUNDLE_ID=fr.neurorun.app
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Contenu PEM du .p8, retours ligne échappés en \n (Docker ne gère pas le multiligne) :
#   APPLE_IAP_KEY_P8="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_IAP_KEY_P8=
# true en développement : les achats faits avec un compte sandbox App Store Connect ne sont acceptés
# que si cette valeur correspond, pour qu'un achat sandbox n'ouvre jamais l'offre en production.
APPLE_IAP_SANDBOX=false
# App Store Connect API — nombre de téléchargements (admin → Plateformes). CLÉ DIFFÉRENTE de la
# clé In-App Purchase ci-dessus : App Store Connect → Users and Access → Integrations →
# App Store Connect API, rôle Admin, Finance ou Sales. Le .p8 ne se télécharge qu'une fois.
# Sans ces variables, l'écran affiche ce qu'il manque au lieu d'une erreur.
APPLE_ASC_ISSUER_ID=
APPLE_ASC_KEY_ID=
# Même format échappé que la clé IAP.
APPLE_ASC_KEY_P8=
# Numéro de vendeur : App Store Connect → Payments and Financial Reports (commence souvent par 8).
APPLE_ASC_VENDOR_NUMBER=
# Version du rapport SALES exigée par Apple. Elle change sans préavis (1_0 jusqu'en janvier 2024,
# 1_1 depuis) : si l'écran affiche « The latest version for this report is X », mets X ici.
APPLE_ASC_REPORT_VERSION=1_1

# Identifiants produit déclarés dans App Store Connect. Ce sont eux qui portent le prix côté iOS :
# les tarifs pilotés depuis l'admin NeuroRun ne s'appliquent qu'au web.
APPLE_PRODUCT_ALLURE=fr.neurorun.app.sub.allure
APPLE_PRODUCT_PERFORMANCE=fr.neurorun.app.sub.performance
# Notifications App Store (renouvellements, résiliations, remboursements) : App Store Connect → ton
# app → General → App Information → App Store Server Notifications, version 2, URL de production
# https://neurorun.fr/api/apple/notifications (et l'URL sandbox pour les tests).

# Notifications d'inscription vers l'app admin (Expo Push → APNs). Facultatif : ne renseigner que
# si « Enhanced Security for Push Notifications » est activé sur le compte Expo (expo.dev →
# Account settings → Access tokens). Sans cette variable les notifications partent quand même.
EXPO_ACCESS_TOKEN=
